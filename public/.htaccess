# ==============================================================================
# FREE INCOME BD — APACHE / cPANEL (.htaccess) CONFIGURATION
# Placed in `public/.htaccess` so Vite automatically copies it to `dist/.htaccess`
# Ready for cPanel `public_html` shared hosting (Apache 2.4+ / LiteSpeed)
# ==============================================================================

Options -MultiViews -Indexes
DirectoryIndex index.html

# ------------------------------------------------------------------------------
# 1. URL REWRITING: HTTPS REDIRECT + REACT ROUTER SPA FALLBACK
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Base path for domain root (`public_html/`).
  # NOTE FOR SUBFOLDER DEPLOYMENT:
  # If deploying to `public_html/subfolder/`, change `RewriteBase /` below to:
  # RewriteBase /subfolder/
  RewriteBase /

  # Force HTTPS (301 Permanent Redirect)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Block direct web access to hidden dotfiles (e.g. .cpanel.yml, .git, .env)
  RewriteRule (^\.|/\.) - [F]

  # Allow existing files and directories (JS, CSS, images, fonts) to be served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other requests (/topup, /tournaments, /wallet, /admin, etc.) to index.html
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# ------------------------------------------------------------------------------
# 2. GZIP / DEFLATE COMPRESSION
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ------------------------------------------------------------------------------
# 3. BROWSER CACHING (IMMUTABLE HASHED ASSETS + FRESH HTML)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML entry point must always revalidate so new deployments take effect immediately
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"

  # Vite hashed static bundles in /assets/ can be cached for 1 year
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images, Icons & Web Fonts
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# 4. SECURITY HEADERS & CACHE-CONTROL DIRECTIVES
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Prevent Clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Strict Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict unnecessary browser APIs
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # HTTP Strict Transport Security (HSTS - 1 year)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # Never cache index.html so users always receive the latest asset hashes
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache hashed Vite assets in /assets/ for 1 year (immutable)
  <FilesMatch "\.(css|js|mjs|jpg|jpeg|png|webp|svg|woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
