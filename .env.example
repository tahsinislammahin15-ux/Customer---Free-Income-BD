# ==============================================================================
# FREE INCOME BD — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# SECURITY WARNING:
# - NEVER commit `.env` or real secret values to Git.
# - NEVER prefix any secret or API key with `VITE_`. Variables prefixed with
#   `VITE_` are embedded into the public client-side bundle at build time.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BUILD & ROUTING CONFIGURATION (PUBLIC — SAFE FOR VITE BUILD)
# ------------------------------------------------------------------------------
# Base path for assets and React Router:
# - Use "/" for domain root deployment (e.g. https://yourdomain.com/)
# - Use "/subfolder/" for subfolder deployment (e.g. https://yourdomain.com/subfolder/)
VITE_BASE_PATH=

# Public Site & Social Links (Optional overrides; live values are also stored in Firestore /settings/public)
VITE_PUBLIC_SITE_URL=
VITE_MAP_EMBED_URL=
VITE_FACEBOOK_URL=
VITE_TELEGRAM_URL=
VITE_WHATSAPP_URL=

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY CONFIGURATION (NEVER EXPOSED TO BROWSER)
# ------------------------------------------------------------------------------
# Application URL for server-side callbacks (only used when running `npm start` Node server)
APP_URL=

# Principal Administrator Bootstrap Email (server-side verification)
BOOTSTRAP_ADMIN_EMAIL=

# Server-Side Gemini API Key (optional; server-side only)
GEMINI_API_KEY=
