{
  "entities": {
    "PublicSettings": {
      "title": "PublicSettings",
      "description": "Publicly readable website branding, contact details, banners, and validated external URLs edited by the Admin.",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "tagline": { "type": "string", "minLength": 2, "maxLength": 200 },
        "logoUrl": { "type": "string", "maxLength": 400 },
        "siteUrl": { "type": "string", "minLength": 8, "maxLength": 300, "pattern": "^https?://.+" },
        "mapEmbedUrl": { "type": "string", "minLength": 8, "maxLength": 500, "pattern": "^https?://.+" },
        "facebookUrl": { "type": "string", "minLength": 8, "maxLength": 300, "pattern": "^https?://.+" },
        "telegramUrl": { "type": "string", "minLength": 8, "maxLength": 300, "pattern": "^https?://.+" },
        "whatsappUrl": { "type": "string", "minLength": 8, "maxLength": 300, "pattern": "^https?://.+" },
        "supportEmail": { "type": "string", "minLength": 5, "maxLength": 160 },
        "supportPhone": { "type": "string", "minLength": 6, "maxLength": 40 },
        "supportWhatsapp": { "type": "string", "minLength": 6, "maxLength": 40 },
        "supportTelegram": { "type": "string", "minLength": 2, "maxLength": 80 },
        "officeAddress": { "type": "string", "minLength": 5, "maxLength": 240 },
        "announcementText": { "type": "string", "minLength": 2, "maxLength": 400 },
        "announcementTextBn": { "type": "string", "minLength": 2, "maxLength": 400 },
        "heroHeadline": { "type": "string", "minLength": 2, "maxLength": 200 },
        "heroHeadlineBn": { "type": "string", "minLength": 2, "maxLength": 200 },
        "heroSubheadline": { "type": "string", "minLength": 2, "maxLength": 500 },
        "heroSubheadlineBn": { "type": "string", "minLength": 2, "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "required": [
        "siteName",
        "siteUrl",
        "mapEmbedUrl",
        "facebookUrl",
        "telegramUrl",
        "whatsappUrl",
        "supportEmail",
        "supportPhone",
        "officeAddress",
        "announcementText",
        "heroHeadline",
        "heroSubheadline",
        "updatedAt",
        "updatedBy"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile stored strictly under the Firebase Auth UID. Owners can update profile details only; financial fields are immutable to clients.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128 },
        "uid": { "type": "string", "minLength": 2, "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "minLength": 5, "maxLength": 160 },
        "phone": { "type": "string", "minLength": 6, "maxLength": 30 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "ffUid": { "type": "string", "maxLength": 30 },
        "ffIgn": { "type": "string", "maxLength": 60 },
        "verified": { "type": "boolean" },
        "banned": { "type": "boolean" },
        "profileCompleted": { "type": "boolean" },
        "mainBalance": { "type": "number" },
        "incomeBalance": { "type": "number" },
        "bonusBalance": { "type": "number" },
        "referralCode": { "type": "string", "minLength": 3, "maxLength": 32 },
        "referredBy": { "type": "string", "maxLength": 32 },
        "referralCount": { "type": "number" },
        "totalEarned": { "type": "number" },
        "tournamentWins": { "type": "number" },
        "joinedAt": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "uid",
        "name",
        "email",
        "phone",
        "role",
        "ffUid",
        "ffIgn",
        "verified",
        "banned",
        "profileCompleted",
        "mainBalance",
        "incomeBalance",
        "bonusBalance",
        "referralCode",
        "referralCount",
        "totalEarned",
        "tournamentWins",
        "joinedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "TopUpOrder": {
      "title": "TopUpOrder",
      "description": "User diamond top-up order record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 2, "maxLength": 128 },
        "userName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "packageId": { "type": "string", "minLength": 2, "maxLength": 64 },
        "packageTitle": { "type": "string", "minLength": 2, "maxLength": 160 },
        "diamonds": { "type": "number" },
        "amountBdt": { "type": "number" },
        "playerUid": { "type": "string", "minLength": 1, "maxLength": 40 },
        "playerIgn": { "type": "string", "maxLength": 60 },
        "topUpType": { "type": "string", "enum": ["uid", "unipin"] },
        "voucherPin": { "type": "string", "maxLength": 80 },
        "paymentMethod": { "type": "string", "enum": ["wallet", "bkash", "nagad", "rocket", "upay"] },
        "transactionId": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["Pending", "Processing", "Completed", "Cancelled"] },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "userId", "userName", "packageId", "packageTitle", "diamonds", "amountBdt", "playerUid", "topUpType", "paymentMethod", "status", "createdAt"]
    },
    "DepositRecord": {
      "title": "DepositRecord",
      "description": "User wallet deposit request stored per userId.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 2, "maxLength": 128 },
        "userName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "method": { "type": "string", "enum": ["bkash", "nagad", "rocket", "upay"] },
        "channel": { "type": "string", "enum": ["Manual", "Instant Gateway"] },
        "senderNumber": { "type": "string", "minLength": 4, "maxLength": 40 },
        "transactionId": { "type": "string", "minLength": 3, "maxLength": 80 },
        "amountBdt": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected", "Completed", "Failed"] },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "userId", "userName", "method", "channel", "senderNumber", "transactionId", "amountBdt", "status", "createdAt"]
    },
    "WithdrawRecord": {
      "title": "WithdrawRecord",
      "description": "User wallet withdrawal request stored per userId.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 2, "maxLength": 128 },
        "userName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "method": { "type": "string", "enum": ["bkash", "nagad", "rocket", "upay"] },
        "walletSource": { "type": "string", "enum": ["incomeBalance", "mainBalance"] },
        "receiverNumber": { "type": "string", "minLength": 4, "maxLength": 40 },
        "amountBdt": { "type": "number" },
        "feeBdt": { "type": "number" },
        "netAmountBdt": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected", "Completed", "Failed"] },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "userId", "userName", "method", "walletSource", "receiverNumber", "amountBdt", "feeBdt", "netAmountBdt", "status", "createdAt"]
    },
    "TaskSubmissionRecord": {
      "title": "TaskSubmissionRecord",
      "description": "Reward task completion submission owned by a single user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128 },
        "taskId": { "type": "string", "minLength": 2, "maxLength": 64 },
        "taskTitle": { "type": "string", "minLength": 2, "maxLength": 200 },
        "userId": { "type": "string", "minLength": 2, "maxLength": 128 },
        "userName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "rewardBdt": { "type": "number" },
        "proofUrl": { "type": "string", "minLength": 3, "maxLength": 400 },
        "proofNote": { "type": "string", "maxLength": 600 },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "adminReason": { "type": "string", "maxLength": 400 },
        "submittedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "taskId", "taskTitle", "userId", "userName", "rewardBdt", "proofUrl", "proofNote", "status", "submittedAt"]
    },
    "SupportTicketRecord": {
      "title": "SupportTicketRecord",
      "description": "User support ticket record owned by the submitting user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 2, "maxLength": 128 },
        "userName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "category": { "type": "string", "enum": ["Top Up Issue", "Tournament Room", "Task Verification", "Deposit / Withdraw"] },
        "subject": { "type": "string", "minLength": 2, "maxLength": 160 },
        "message": { "type": "string", "minLength": 2, "maxLength": 1200 },
        "status": { "type": "string", "enum": ["Open", "Resolved"] },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "userId", "userName", "category", "subject", "message", "status", "createdAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted RBAC document identifying a verified Principal Administrator.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "minLength": 5, "maxLength": 160 },
        "role": { "type": "string", "enum": ["admin"] },
        "mustChangePassword": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "mustChangePassword", "createdAt", "updatedAt"]
    },
    "CatalogItem": {
      "title": "CatalogItem",
      "description": "Publicly readable product package, tournament, task, or news item managed by Admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "category": { "type": "string", "minLength": 2, "maxLength": 40 },
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "priceOrRewardBdt": { "type": "number" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "category", "title", "priceOrRewardBdt", "active", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable admin security audit trail entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64 },
        "adminUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adminEmail": { "type": "string", "minLength": 5, "maxLength": 160 },
        "action": { "type": "string", "minLength": 2, "maxLength": 80 },
        "target": { "type": "string", "minLength": 1, "maxLength": 120 },
        "details": { "type": "string", "minLength": 1, "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "adminUid", "adminEmail", "action", "target", "details", "createdAt"]
    },
    "WalletAccount": {
      "title": "WalletAccount",
      "description": "Backend-computed double-entry wallet snapshot. Users can ONLY read their own wallet; client SDK writes are strictly forbidden.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "mainBalance": { "type": "number" },
        "incomeBalance": { "type": "number" },
        "bonusBalance": { "type": "number" },
        "lockedPendingBdt": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "mainBalance", "incomeBalance", "bonusBalance", "lockedPendingBdt", "updatedAt"]
    },
    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "User transaction or double-entry ledger record scoped strictly to owner.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 2, "maxLength": 128 },
        "direction": { "type": "string", "enum": ["credit", "debit"] },
        "balanceType": { "type": "string", "enum": ["Main", "Income", "Bonus"] },
        "amountBdt": { "type": "number" },
        "type": { "type": "string", "minLength": 2, "maxLength": 40 },
        "method": { "type": "string", "maxLength": 60 },
        "referenceId": { "type": "string", "minLength": 2, "maxLength": 128 },
        "description": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected", "Completed", "Failed"] },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "userId", "direction", "balanceType", "amountBdt", "type", "referenceId", "status", "createdAt"]
    },
    "VaultSecret": {
      "title": "VaultSecret",
      "description": "Server-only encrypted secret record (completely blocked from client SDK read/write).",
      "type": "object",
      "properties": {
        "secretId": { "type": "string", "minLength": 2, "maxLength": 64 },
        "ciphertext": { "type": "string", "minLength": 16, "maxLength": 2048 }
      },
      "required": ["secretId", "ciphertext"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/PublicSettings" },
      "description": "Public site configuration document (/settings/public)."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user profile documents keyed by Firebase Auth UID."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/TopUpOrder" },
      "description": "User diamond top-up orders scoped strictly by userId."
    },
    "/deposits/{depositId}": {
      "schema": { "$ref": "#/entities/DepositRecord" },
      "description": "User wallet deposit records scoped strictly by userId."
    },
    "/withdrawals/{withdrawId}": {
      "schema": { "$ref": "#/entities/WithdrawRecord" },
      "description": "User wallet withdrawal requests scoped strictly by userId."
    },
    "/transactions/{trxId}": {
      "schema": { "$ref": "#/entities/LedgerEntry" },
      "description": "User wallet transaction records scoped strictly by userId."
    },
    "/task_submissions/{subId}": {
      "schema": { "$ref": "#/entities/TaskSubmissionRecord" },
      "description": "User task completion submissions scoped strictly by userId."
    },
    "/support_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicketRecord" },
      "description": "User support tickets scoped strictly by userId."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Authoritative RBAC collection of Principal Administrators."
    },
    "/catalog/{itemId}": {
      "schema": { "$ref": "#/entities/CatalogItem" },
      "description": "Live catalog items (packages, tournaments, tasks, blog posts) managed by Admin."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only immutable administrator audit log."
    },
    "/wallets/{userId}": {
      "schema": { "$ref": "#/entities/WalletAccount" },
      "description": "Backend-authoritative user wallet snapshot; users can only read their own document and can never write."
    },
    "/wallet_ledger/{entryId}": {
      "schema": { "$ref": "#/entities/LedgerEntry" },
      "description": "Backend-authoritative double-entry ledger; users can only read their own entries and can never write."
    },
    "/vault_secrets/{secretId}": {
      "schema": { "$ref": "#/entities/VaultSecret" },
      "description": "Server-only encrypted secrets collection; client SDK read and write are strictly denied."
    }
  }
}
